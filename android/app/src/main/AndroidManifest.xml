<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Yerel müzik dosyalarını okuma izinleri (Android 12 ve altı / 13 ve üstü) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <!-- Bağlantıdan (URL) çalma listesi içe aktarma ve bulut senkronizasyonu için -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Bildirim panelindeki müzik kontrolü ve arka planda çalma için -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Bluetooth/kablolu kulaklık tuşlarını almak için -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <application
        android:label="ultimate_mobile"
        android:name=".UltimateApplication"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Metni uygulamaya gönder: "Paylaş -> ultimate_mobile" ile hızlı not -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- ultimate://notes/add -> doğrudan yeni not ekranı (kısayol, bağlantı) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="ultimate" android:host="notes" />
            </intent-filter>
            <!-- Simgeye uzun basınca çıkan "Hızlı not" kısayolu -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>
        <!-- Ana ekran takvim widget'ı (home_widget) -->
        <receiver
            android:name=".CalendarWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/calendar_widget_info" />
        </receiver>

        <!-- Widget'ta güne tıklayınca seçili günü kaydeden broadcast -->
        <receiver
            android:name=".CalendarDaySelectReceiver"
            android:exported="false" />

        <!-- Bildirimdeki "Not al" alanına yazılan hızlı notu işler -->
        <receiver
            android:name=".QuickNoteReceiver"
            android:exported="false" />

        <!-- Bildirim panelindeki müzik kontrolü + arka planda çalma servisi -->
        <service
            android:name=".MediaPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
